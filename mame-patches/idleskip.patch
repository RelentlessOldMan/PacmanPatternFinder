@@ -359,6 +359,32 @@ Boards:
  *
  *************************************/
 
+// PacmanPatternFinder: with the environment variable PACMAN_IDLESKIP=1, puckman/pacman's main
+// loop (0x238D: LD HL,(4C82); LD A,(HL); AND A; JP M,238D) sleeps until the next interrupt
+// instead of spinning while its task queue is empty. Every game change happens in the interrupt,
+// so nothing the game does differs; only fewer Z80 instructions are emulated.
+void pacman_state::machine_start()
+{
+	driver_device::machine_start();
+	char const *const env = std::getenv("PACMAN_IDLESKIP");
+	if (!env || !*env || *env == '0' || strcmp(machine().system().name, "pacman"))
+		return;
+	address_space &prg = m_maincpu->space(AS_PROGRAM);
+	u8 const *const ram = reinterpret_cast<u8 const *>(prg.get_read_ptr(0x4c00));
+	if (!ram)
+		return;
+	m_idle_tap = prg.install_read_tap(0x4c82, 0x4c82, "idleskip",
+		[this, ram] (offs_t offset, u8 &data, u8 mem_mask)
+		{
+			offs_t const pc = m_maincpu->pc();
+			if (pc < 0x238d || pc > 0x2392)
+				return;
+			offs_t const task = ram[0x82] | (ram[0x83] << 8);
+			if (task >= 0x4cc0 && task <= 0x4cff && (ram[task - 0x4c00] & 0x80))
+				m_maincpu->spin_until_interrupt();
+		});
+}
