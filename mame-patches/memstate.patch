+//-------------------------------------------------
+//  schedule_mem_save/schedule_mem_load - like
+//  schedule_save/schedule_load, but to/from an
+//  in-memory slot
+//-------------------------------------------------
+
+void running_machine::schedule_mem_save(std::string &&slot)
+{
+	m_saveload_pending_file.clear();
+	m_saveload_memslot = std::move(slot);
+	m_saveload_schedule = saveload_schedule::SAVE;
+	m_saveload_schedule_time = this->time();
+	resume();
+}
+
+void running_machine::schedule_mem_load(std::string &&slot)
+{
+	m_saveload_pending_file.clear();
+	m_saveload_memslot = std::move(slot);
+	m_saveload_schedule = saveload_schedule::LOAD;
+	m_saveload_schedule_time = this->time();
+	resume();
+}
+
+
