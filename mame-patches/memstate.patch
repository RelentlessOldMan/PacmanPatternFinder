 void running_machine::handle_saveload()
 {
+	// in-memory slot: same timing rules as a file, but no file and no compression
+	if (!m_saveload_memslot.empty())
+	{
+		if (!m_scheduler.can_save())
+		{
+			if ((this->time() - m_saveload_schedule_time) <= attotime::from_seconds(1))
+				return; // try again after the next timeslice
+			m_memstate_errors++;
+			popmessage("Error: Unable to save/load memory state %s due to pending anonymous timers.", m_saveload_memslot);
+		}
+		else if (m_saveload_schedule == saveload_schedule::SAVE)
+		{
+			std::vector<u8> &buf = m_memstates[m_saveload_memslot];
+			buf.resize(ram_state::get_size(m_save));
+			if (m_save.write_buffer(buf.data(), buf.size()) != STATERR_NONE)
+			{
+				m_memstates.erase(m_saveload_memslot);
+				m_memstate_errors++;
+			}
+		}
+		else
+		{
+			auto const it = m_memstates.find(m_saveload_memslot);
+			if ((it == m_memstates.end()) || (m_save.read_buffer(it->second.data(), it->second.size()) != STATERR_NONE))
+				m_memstate_errors++;
+		}
+		m_saveload_memslot.clear();
+		m_saveload_schedule = saveload_schedule::NONE;
+		return;
+	}
+
